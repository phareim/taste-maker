# ios/project.yml is the source of truth; the .xcodeproj is regenerated by
# `xcodegen generate` and must never be hand-edited, so it isn't tracked.
ios/TasteCapture.xcodeproj
# Same story for these: xcodegen overwrites whatever sits at a target's
# info.path/entitlements.path on every run. Edit project.yml, not these.
ios/TasteCapture/Info.plist
ios/TasteCapture/TasteCapture.entitlements
ios/TasteCaptureShare/Info.plist
ios/TasteCaptureShare/TasteCaptureShare.entitlements
ios/**/.build
ios/**/*.xcworkspace/xcuserdata
DerivedData
