# ios/project.yml is the source of truth and the generated files below must
# never be hand-edited — but they ARE tracked, because Xcode Cloud clones the
# repo and can't run xcodegen. It needs the .xcodeproj and the shared scheme
# to exist. Regeneration is byte-stable, so this doesn't churn.
ios/**/.build
ios/**/xcuserdata
ios/**/*.xcworkspace/xcuserdata
DerivedData

# wrangler local secrets
.dev.vars
